# Template for the local Docker run. Copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# .env is gitignored; this file is not, so never put real values here.

# production = starts empty, you upload your own export, password gate.
# demo       = synthetic sample dataset, uploads disabled, no password.
APP_MODE=production

# Required in production mode — the app refuses to start without them rather
# than falling back to a guessable default.
APP_PASSWORD=
SESSION_SECRET=

# Optional. Without a key the report still renders; only the written
# commentary is skipped, and it says so.
GOOGLE_API_KEY=
LLM_MODEL=gemma-4-31b-it

# Required for PDF export inside a container — Chromium cannot start its own
# sandbox there. Safe here: the renderer loads only this app's HTML with
# JavaScript disabled and network requests blocked.
PUPPETEER_NO_SANDBOX=1
